#include <SoftwareSerial.h>
#include "RoboClaw.h"

// Hardware Setup
SoftwareSerial roboclawSerial(10, 11); // RX (Pin 10), TX (Pin 11)
RoboClaw roboclaw(&roboclawSerial, 10000);

#define ADDR 0x80

// --- WATCHDOG SETTINGS ---
unsigned long lastCommandTime = 0;      // Stores the timestamp of the last valid command
const unsigned long TIMEOUT_THRESHOLD = 500; // Stop motors if no command for 500ms

// --- PID CONSTANTS ---
float Kp = .5;
float Ki = 0.1;
float Kd = 0.0;
uint32_t qpps = 10000000; 

void setup() {
  Serial.begin(115200);        // USB to Jetson
  roboclaw.begin(38400);       // To RoboClaw
  
  roboclaw.SetM1VelocityPID(ADDR, Kp, Ki, Kd, qpps);
  roboclaw.SetM2VelocityPID(ADDR, Kp, Ki, Kd, qpps);
  
  pinMode(LED_BUILTIN, OUTPUT);
  Serial.println("PID_CONTROLLER_READY_WITH_WATCHDOG");
  
  lastCommandTime = millis(); // Initialize timer
}

void loop() {
  // 1. Handle incoming commands from Jetson
  if (Serial.available() > 0) {
    String data = Serial.readStringUntil('\n');
    data.trim();
    int commaIndex = data.indexOf(',');
    
    if (commaIndex != -1) {
      long speedL = data.substring(0, commaIndex).toInt();
      long speedR = data.substring(commaIndex + 1).toInt();
      
      // Execute motor commands
      roboclaw.SpeedM1(ADDR, speedL); 
      roboclaw.SpeedM2(ADDR, speedR);

      // Update the watchdog timer because we just got a valid command
      lastCommandTime = millis();
      digitalWrite(LED_BUILTIN, HIGH); // Visual feedback: we are receiving data
    }
  }

  // 2. SAFETY WATCHDOG CHECK
  // If the difference between now and the last command is too large, stop the motors
  if (millis() - lastCommandTime > TIMEOUT_THRESHOLD) {
    roboclaw.SpeedM1(ADDR, 0); 
    roboclaw.SpeedM2(ADDR, 0);
    digitalWrite(LED_BUILTIN, LOW); // Visual feedback: Timeout active
  }

  // 3. CONSTANTLY report status back to Python
  static uint32_t lastReport = 0;
  if (millis() - lastReport > 50) { 
    uint8_t status1, status2;
    bool valid1, valid2;
    
    int32_t encL = roboclaw.ReadEncM1(ADDR, &status1, &valid1);
    int32_t encR = roboclaw.ReadEncM2(ADDR, &status2, &valid2);
    int32_t speedL = roboclaw.ReadSpeedM1(ADDR, &status1, &valid1);
    int32_t speedR = roboclaw.ReadSpeedM2(ADDR, &status2, &valid2);

    if (valid1 && valid2) {
      Serial.print("TELEMETRY:");
      Serial.print(encL); Serial.print(",");
      Serial.print(encR); Serial.print(",");
      Serial.print(speedL); Serial.print(",");
      Serial.println(speedR);
    }
    lastReport = millis();
  }
}
